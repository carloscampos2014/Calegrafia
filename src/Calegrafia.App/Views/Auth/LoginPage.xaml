<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Calegrafia.App.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Calegrafia.App.ViewModels.Auth"
    Title="Entrar"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="32,48,32,32"
            Spacing="0"
            VerticalOptions="Center">

            <!-- Logo / título -->
            <Label
                Style="{StaticResource Headline}"
                Text="Calegrafia"
                Margin="0,0,0,4" />

            <Label
                Style="{StaticResource SubHeadline}"
                Text="Aprenda a escrever com elegância"
                FontSize="16"
                Margin="0,0,0,40" />

            <!-- Mensagem de sucesso (cadastro confirmado, etc.) -->
            <Border
                BackgroundColor="{StaticResource Secondary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                Padding="12,8"
                Margin="0,0,0,16"
                IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}">
                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="{StaticResource Tertiary}"
                    FontSize="13" />
            </Border>

            <!-- Email -->
            <Label Text="Email" FontSize="13" Margin="0,0,0,4" />
            <Entry
                x:Name="EntryEmail"
                Text="{Binding Email}"
                Placeholder="seu@email.com"
                Keyboard="Email"
                ReturnType="Next"
                SemanticProperties.Hint="Campo de email para login"
                Margin="0,0,0,16" />

            <!-- Senha -->
            <Label Text="Senha" FontSize="13" Margin="0,0,0,4" />
            <Entry
                x:Name="EntrySenha"
                Text="{Binding Senha}"
                Placeholder="Sua senha"
                IsPassword="True"
                ReturnType="Done"
                ReturnCommand="{Binding LoginCommand}"
                SemanticProperties.Hint="Campo de senha para login"
                Margin="0,0,0,8" />

            <!-- Esqueci a senha -->
            <Label
                Text="Esqueci a senha"
                TextColor="{StaticResource Primary}"
                FontSize="13"
                HorizontalOptions="End"
                Margin="0,0,0,24">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IrParaRecuperarSenhaCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Mensagem de erro -->
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red"
                FontSize="13"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,12" />

            <!-- Botão Entrar -->
            <Button
                Text="Entrar"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                SemanticProperties.Description="Botão para entrar na conta"
                Margin="0,0,0,16" />

            <!-- Loading -->
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center"
                Margin="0,0,0,16" />

            <!-- Separador -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="{StaticResource Gray200}"
                Margin="0,8,0,16" />

            <!-- Cadastrar -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Não tem uma conta?" FontSize="14" />
                <Label
                    Text="Cadastre-se"
                    TextColor="{StaticResource Primary}"
                    FontSize="14"
                    FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrParaCadastroCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
