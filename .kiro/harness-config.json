{
  "version": "1.0",
  "project": "Calegrafia",
  "components": {
    "templates": true,
    "knowledge_capture": true,
    "review_validation": true,
    "pre_requirements": true,
    "quality_reporting": true,
    "retrospective": true,
    "onboarding": true,
    "tech_debt_detector": true,
    "agent_router": true,
    "git_guardrails": true
  },
  "thresholds": {
    "quality_score_verde": 90,
    "quality_score_amarelo": 70,
    "completude_minima": 70,
    "padrao_captura_repeticoes": 3
  },
  "build": {
    "command": "dotnet build src/Calegrafia.Api/Calegrafia.Api.csproj src/Calegrafia.Application/Calegrafia.Application.csproj -c Debug --no-restore --nologo -v quiet",
    "full_command": "dotnet build Calegrafia.slnx -c Debug",
    "test_command": "dotnet test tests/ --logger console;verbosity=minimal",
    "lint_command": "dotnet format --verify-no-changes",
    "note": "build usa projetos backend apenas para verificacao rapida; full_command para build completo incluindo MAUI"
  },
  "repo": {
    "owner": "carloscampos2014",
    "name": "Calegrafia",
    "default_branch": "master"
  }
}
