{
  "version": "1.0",
  "project": "Calegrafia",
  "components": {
    "templates": true,
    "knowledge_capture": true,
    "review_validation": true,
    "pre_requirements": true,
    "quality_reporting": true,
    "retrospective": true,
    "onboarding": true,
    "tech_debt_detector": true,
    "agent_router": true,
    "git_guardrails": true
  },
  "thresholds": {
    "quality_score_verde": 90,
    "quality_score_amarelo": 70,
    "completude_minima": 70,
    "padrao_captura_repeticoes": 3
  },
  "build": {
    "command": "dotnet build Calegrafia.sln -c Debug",
    "test_command": "dotnet test tests/ --logger console;verbosity=minimal",
    "lint_command": "dotnet format --verify-no-changes"
  },
  "repo": {
    "owner": "carloscampos2014",
    "name": "Calegrafia",
    "default_branch": "master"
  }
}
